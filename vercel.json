{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pip install --disable-pip-version-check --no-cache-dir -r requirements.txt",
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,examples/**,sdk/**,mcp/**,plugins/**,agentkit/**,docs/**,aisa-skill/**,.github/**,Dockerfile*,*.md,*.bak,pyproject.toml,poetry.lock,uv.lock}"
    },
    "src/main.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,examples/**,sdk/**,mcp/**,plugins/**,agentkit/**,docs/**,aisa-skill/**,.github/**,Dockerfile*,*.md,*.bak,pyproject.toml,poetry.lock,uv.lock}"
    }
  }
}

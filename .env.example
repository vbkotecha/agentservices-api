# Human billing door (optional — x402-only mode works without these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_JWT_SECRET=
SESSION_SECRET=

# Stripe prepaid credits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREDITS_10=

# Canonical public URL (used for OAuth redirect URIs and Checkout success/cancel)
PUBLIC_BASE_URL=https://agentservices.to

# Optional: override file storage path for local tests (when REDIS_URL unset)
# AGENTSERVICES_CREDITS_DIR=/tmp/agentservices-kv

# Durable storage for credits + OAuth pending state (required on Vercel)
REDIS_URL=

# Existing x402 / CDP (unchanged — wallet agents)
# X402_PAY_TO=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
